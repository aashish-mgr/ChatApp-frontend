# Base URL of the Socket.IO server (chat_backend).
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Base URL of the REST API used for file uploads and downloads. It is served
# by the same backend as the socket, so it defaults to the socket URL's
# origin. Set it only when the two are deployed separately.
# NEXT_PUBLIC_API_URL=http://localhost:3000
